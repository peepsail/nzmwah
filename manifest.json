{
  "manifest_version": 3,
  "name": "NZMwah",
  "version": "1.3.6",
  "description": "A little mwah between the lines.",
  "minimum_chrome_version": "111",
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.businessdesk.co.nz/*",
    "https://*.nzherald.co.nz/*",
    "https://*.thepost.co.nz/*",
    "https://*.thepress.co.nz/*",
    "https://*.stuff.co.nz/*",
    "https://*.waikatotimes.co.nz/*",
    "https://*.piano.io/*",
    "https://*.odt.co.nz/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.businessdesk.co.nz/*",
        "https://*.nzherald.co.nz/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.businessdesk.co.nz/*"
      ],
      "css": [
        "reader.css"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "js": [
        "reveal.js"
      ]
    },
    {
      "matches": [
        "https://*.nzherald.co.nz/*"
      ],
      "css": [
        "layout.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.thepost.co.nz/*",
        "https://*.thepress.co.nz/*",
        "https://*.waikatotimes.co.nz/*"
      ],
      "css": [
        "view.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.stuff.co.nz/*"
      ],
      "css": [
        "view.css",
        "stuff.css"
      ],
      "js": [
        "stuff.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.odt.co.nz/*"
      ],
      "css": [
        "style04.css"
      ],
      "js": [
        "script04.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "r01",
        "enabled": true,
        "path": "rules/01.json"
      },
      {
        "id": "r02",
        "enabled": true,
        "path": "rules/02.json"
      },
      {
        "id": "r03",
        "enabled": true,
        "path": "rules/03.json"
      },
      {
        "id": "r04",
        "enabled": true,
        "path": "rules/04.json"
      }
    ]
  }
}
